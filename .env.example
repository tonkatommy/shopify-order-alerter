# Tommy Tinkers NZ — Shopify order alerter
#
# Copy to .env and fill in. Never commit .env — the Shopify token, the Discord
# webhook URL and the Resend API key are all credentials.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Shopify (required)
# ---------------------------------------------------------------------------

# Your permanent myshopify domain, no scheme, no trailing slash.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Admin API access token from the custom app. Starts with "shpat_".
# The app needs exactly one scope: read_orders. Nothing else.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pinned Admin API version. Deliberately a dated string, never "unstable" —
# bump this one line when you want to move to a newer version.
SHOPIFY_API_VERSION=2026-07

# Store handle used in admin.shopify.com deep links. Defaults to the subdomain
# of SHOPIFY_SHOP_DOMAIN; only set this if your admin URL differs.
# SHOPIFY_STORE_HANDLE=your-store

# How many times to attempt a failing Shopify call before giving up.
# SHOPIFY_MAX_RETRIES=3

# Base delay for exponential backoff, in milliseconds (1000 -> 1s, 2s, 4s).
# SHOPIFY_RETRY_BASE_MS=1000

# ---------------------------------------------------------------------------
# Discord (required)
# ---------------------------------------------------------------------------

# Channel webhook URL. This is a credential — anyone holding it can post to
# your channel. Treat it like a password.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Email digest (Resend SMTP by default)
# ---------------------------------------------------------------------------

# Set to false to run Discord-only with no email at all.
EMAIL_ENABLED=true

# Resend SMTP endpoint. Any other SMTP provider works — change host/port/user.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587

# true only for implicit-TLS ports (465). Port 587 uses STARTTLS, so false.
SMTP_SECURE=false

# For Resend the username is the literal string "resend".
SMTP_USER=resend

# For Resend this is your API key (starts with "re_"), not an account password.
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain you have verified in Resend.
EMAIL_FROM=Tommy Tinkers NZ <alerts@yourdomain.co.nz>

# Digest recipients. Comma-separated for more than one.
EMAIL_TO=you@yourdomain.co.nz

# ---------------------------------------------------------------------------
# Alerting behaviour
# ---------------------------------------------------------------------------

# An order alerts on Discord once it has been unfulfilled for longer than this.
ALERT_THRESHOLD_HOURS=48

# IANA timezone used for displayed dates and for the cron schedules.
TIMEZONE=Pacific/Auckland

# Currency used when Shopify does not return one. Display only.
CURRENCY=NZD

# Hourly overdue check. Standard 5-field cron, evaluated in TIMEZONE.
CHECK_CRON=0 * * * *

# Daily digest at 09:00 in TIMEZONE.
DIGEST_CRON=0 9 * * *

# Run one check immediately on container start instead of waiting for the hour.
RUN_CHECK_ON_START=true

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

# Dedup state file. Must live on the mounted volume so restarts do not re-alert.
STATE_FILE_PATH=/data/state.json

# ---------------------------------------------------------------------------
# Branding (display only)
# ---------------------------------------------------------------------------

STORE_NAME=Tommy Tinkers NZ
EMBED_FOOTER=Tommy Tinkers NZ · Order Alerter
